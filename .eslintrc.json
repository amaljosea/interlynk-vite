{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react", "react-hooks", "unused-imports"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "no-unused-vars": "warn",
    "react/no-unescaped-entities": "warn",
    "no-useless-escape": "warn",
    "react/display-name": "warn",
    "react-hooks/rules-of-hooks": "warn",
    "react/no-deprecated": "warn",
    "unused-imports/no-unused-imports": "warn",
    "no-console": ["warn", { "allow": ["warn", "info"] }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@chakra-ui/react",
            "importNames": ["useToast"],
            "message": "Please use 'useCustomToast' instead."
          },
          {
            "name": "@chakra-ui/react",
            "importNames": ["Modal"],
            "message": "Please use 'LynkModal' instead."
          },
          {
            "name": "@chakra-ui/react",
            "importNames": ["useColorModeValue"],
            "message": "Please use 'useThemeColor' hook and values from 'theme' instead."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "VariableDeclarator[init.callee.name=/use(Query|PaginatedQuery)/] > ObjectPattern > Property[key.name='refetch']",
        "message": "Avoid using 'refetch'. Apollo client is configured to refetch all active queries after mutations. If refetch is still required, consider using 'refetchActiveQueries' or the 'RefreshBtn' component."
      },
      {
        "selector": "VariableDeclarator[init.callee.name='useLazyQuery'] > ArrayPattern > ObjectPattern > Property[key.name='refetch']",
        "message": "Avoid using 'refetch'. Apollo client is configured to refetch all active queries after mutations. If refetch is still required, consider using 'refetchActiveQueries' or the 'RefreshBtn' component."
      },
      {
        "selector": "Literal[value=/^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$/]",
        "message": "Avoid using hex color values directly. Please use a theme variable or 'useThemeColor' hook instead."
      },
      {
        "selector": "Literal[value=/^(gray|red|blue|green|yellow|orange|purple|pink|teal|cyan|blackAlpha|whiteAlpha).[0-9]{3}$/]",
        "message": "Avoid using Chakra UI color values directly (e.g., 'gray.100', 'red.500'). Please use a theme variable or 'useThemeColor' hook instead."
      }
    ]
  }
}
