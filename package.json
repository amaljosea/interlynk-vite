  "resolutions": {
    "react-error-overlay": "6.0.9"
  },
  "scripts": {
    "prestart": "node checkEnv.js",
    "start": "set PORT=3001 && react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "deploy": "npm run build",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "lint": "eslint --quiet  .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky install",
    "format": "pretty-quick --staged",
    "format:all": "prettier -w . && git add -A .",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org interlync --project javascript-react ./build && sentry-cli sourcemaps upload --org interlync --project javascript-react ./build"
  },
  "optionalDependencies": {
    "@babel/core": "7.26.9"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-react-jsx-source": "^7.25.9",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.13.5",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^2.0.0",
    "gulp": "^5.0.0",
    "gulp-append-prepend": "1.0.9",
    "husky": "^9.1.7",
    "prettier": "^3.5.2",
    "pretty-quick": "^4.0.0",
    "react-error-overlay": "^6.1.0"
  },
  "browserslist": {
    "production": [
      "cover 99.8%",
      "not dead",
      "not OperaMini all"
    ],
    "development": [
      "cover 99.8%",
      "not dead",
      "not OperaMini all"
    ]
  }
